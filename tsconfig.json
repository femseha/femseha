{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "types": ["node"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Path mapping */
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@entry/ArticlesPage": ["src/pages/ArticlesPageEntryServer.tsx"],
      "@entry/ArticleView": ["src/pages/ArticleViewEntryServer.tsx"],
      "@entry/AdminPage": ["src/pages/AdminPageEntryServer.tsx"],
      "@entry/DoctorPage": ["src/pages/DoctorPageEntryServer.tsx"],
      "@entry/ConsultationPage": ["src/pages/ConsultationPageEntryServer.tsx"],
      "@entry/DisclaimerPage": ["src/pages/DisclaimerPageEntryServer.tsx"],
      "@entry/NotFoundPage": ["src/pages/NotFoundPageEntryServer.tsx"],
      "@entry/ClusterPage": ["src/pages/ClusterPageEntryServer.tsx"],
      "@entry/PregnancyCalculatorPage": ["src/pages/PregnancyCalculatorPageEntryServer.tsx"]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "vite.config.ts"]
}
