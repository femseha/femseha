{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "sitemap:check": "node scripts/generate-sitemap.mjs --check",
    "build": "node scripts/generate-sitemap.mjs && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "seo:validate": "node scripts/seo-validate.mjs",
    "seo:ssr": "node scripts/ssr-verify.mjs",
    "seo:audit": "node scripts/audit-indexing.mjs",
    "verify:ssr": "node scripts/ssr-verify.mjs",
    "audit:indexing": "node scripts/audit-indexing.mjs",
    "admin:selftest": "node scripts/admin-publish.mjs --self-test"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-router-dom": "6.22.3",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0"
  }
}
